{
  "expo": {
    "name": "Memoir",
    "slug": "memoir",
    "scheme": "memoir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/appstore.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memoir.app",
      "icon": "./assets/AppIcons/appstore.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Memoir needs access to your photo library to display your photos.",
        "NSPhotoLibraryAddUsageDescription": "Memoir needs permission to save photos to your library."
      }
    },
    "android": {
      "package": "com.memoir.app",
      "icon": "./assets/AppIcons/playstore.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/AppIcons/playstore.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/AppIcons/appstore.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Memoir needs access to your photos to build your gallery.",
          "savePhotosPermission": "Memoir can save edits back to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/AppIcons/appstore.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/AppIcons/appstore.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
