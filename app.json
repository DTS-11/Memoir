{
  "expo": {
    "name": "Memoir",
    "slug": "memoir",
    "scheme": "memoir",
    "version": "0.8.0",
    "orientation": "portrait",
    "icon": "./assets/memoir_logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/memoir_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memoir.app",
      "icon": "./assets/memoir_logo.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Memoir needs access to your photo library to display your photos.",
        "NSPhotoLibraryAddUsageDescription": "Memoir needs permission to save photos to your library.",
        "NSFaceIDUsageDescription": "Memoir uses Face ID to unlock Hidden photos."
      }
    },
    "android": {
      "package": "com.memoir.app",
      "icon": "./assets/memoir_logo.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/memoir_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/memoir_logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Memoir needs access to your photos to build your gallery.",
          "savePhotosPermission": "Memoir can save edits back to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-image",
      "expo-font",
      "expo-video",
      "expo-sharing",
      "expo-local-authentication",
      "expo-sqlite",
      "expo-asset"
    ],
    "assetBundlePatterns": [
      "assets/**",
      "assets/models/*"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
