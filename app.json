{
  "expo": {
    "name": "Memoir",
    "slug": "memoir",
    "scheme": "memoir",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/memoir_logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memoir.app",
      "icon": "./assets/memoir_logo.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Memoir needs access to your photo library to display your photos.",
        "NSPhotoLibraryAddUsageDescription": "Memoir needs permission to save photos to your library.",
        "NSFaceIDUsageDescription": "Memoir uses Face ID to unlock Hidden photos."
      }
    },
    "android": {
      "package": "com.memoir.app",
      "versionCode": 6,
      "icon": "./assets/memoir_logo.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/memoir_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/memoir_logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/memoir_logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#08080E",
          "imageWidth": 160
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "ndkVersion": "27.1.12297006",
            "abiFilters": [
              "arm64-v8a"
            ],
            "packagingOptions": {
              "pickFirst": [
                "lib/arm64-v8a/libc++_shared.so",
                "lib/x86_64/libc++_shared.so"
              ]
            }
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Memoir needs access to your photos to build your gallery.",
          "savePhotosPermission": "Memoir can save edits back to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-image",
      "expo-font",
      "expo-video",
      "expo-sharing",
      "expo-local-authentication",
      "expo-sqlite",
      "expo-asset"
    ],
    "assetBundlePatterns": [
      "assets/**"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92e3da19-b67b-4b43-b762-0ce1a3c74ba7"
      }
    }
  }
}
